{
  "$comment": "Kindgi's design tokens: the one source for the website, the docs and the console. Edit this file, then run `pnpm run tokens:build` to write tokens.css; `pnpm run check:tokens` (CI) fails if tokens.css is out of date or a checked pair misses its contrast. See README.md.",
  "prefix": "kg",
  "colors": {
    "page": {
      "light": "#F3F4F7",
      "dark": "#10151F",
      "use": "The page: your side. Drafting paper in light, night steel in dark."
    },
    "card": { "light": "#FFFFFF", "dark": "#171E2B", "use": "Cards, tables, panels on the page." },
    "field": { "light": "#FFFFFF", "dark": "#10151F", "use": "Form fields: text boxes, selects." },
    "text": { "light": "#1C2433", "dark": "#E6E8EE", "use": "Text and headings." },
    "text-2": {
      "light": "#535D6E",
      "dark": "#A3ACBC",
      "use": "Secondary text: descriptions, captions, labels."
    },
    "heading-2": {
      "light": "#4D6080",
      "dark": "#8EA0C0",
      "use": "A heading's second line (steel)."
    },
    "rule": {
      "light": "#C7CCD6",
      "dark": "#2A3446",
      "use": "Hairlines between rows and around cards. Decorative."
    },
    "line": {
      "light": "#1C2433",
      "dark": "#5E6A80",
      "use": "Drawn lines: boxes, outline buttons, form field edges."
    },
    "kindgi": {
      "light": "#1C2433",
      "dark": "#241A2D",
      "use": "What Kindgi runs: graphite in light, plum-black in dark. The website's Kindgi surfaces."
    },
    "kindgi-text": { "light": "#F1F2F5", "dark": "#EEEAF2", "use": "Text on the Kindgi surface." },
    "kindgi-text-2": {
      "light": "#A9B1BF",
      "dark": "#B5AAC1",
      "use": "Secondary text on the Kindgi surface."
    },
    "kindgi-rule": {
      "light": "#323C50",
      "dark": "#3F2E4A",
      "use": "Hairlines on the Kindgi surface."
    },
    "kindgi-band": {
      "light": "#2B1B32",
      "dark": "#35233F",
      "use": "Plum-graphite: a closing band set apart from the Kindgi surface (the website's hero)."
    },
    "kindgi-band-rule": { "light": "#4A3354", "dark": "#54405F", "use": "Hairlines on the band." },
    "action": {
      "light": "#6C1A5A",
      "dark": "#DA8BD0",
      "use": "Plum: a primary action, or a person decides. Rare outside the website: never on things that repeat (links, menus, rows)."
    },
    "action-hover": {
      "light": "#561447",
      "dark": "#E4A6DC",
      "use": "A filled action button on hover: a light shade change."
    },
    "on-action": { "light": "#FFFFFF", "dark": "#1C1222", "use": "Text on an action button." },
    "accent": {
      "light": "#DA8BD0",
      "dark": "#E7A8DF",
      "use": "Orchid: the accent on the Kindgi surface (buttons, selected tabs, labels there)."
    },
    "accent-hover": { "light": "#E4A6DC", "dark": "#F0C0E9", "use": "An accent button on hover." },
    "on-accent": { "light": "#1C2433", "dark": "#241A2D", "use": "Text on an accent button." },
    "link": {
      "light": "#535D6E",
      "dark": "#A3ACBC",
      "use": "Links: the words and an arrow, no underline."
    },
    "link-hover": {
      "light": "#1C2433",
      "dark": "#E6E8EE",
      "use": "A link on hover: stronger text."
    },
    "code-bg": {
      "light": "#1C2433",
      "dark": "#0B0F17",
      "use": "Code blocks: neutral in both themes (with a rule border in dark)."
    },
    "code-text": {
      "light": "#F1F2F5",
      "dark": "#E6E8EE",
      "use": "Code text; strings and the selected tab take the accent."
    },
    "status-person": {
      "light": "#6C1A5A",
      "dark": "#E7A8DF",
      "use": "Status: a person decides (waiting for a reviewer, pending approval). Icon and word."
    },
    "status-person-bg": {
      "light": "#F3E3EF",
      "dark": "#35182F",
      "use": "Its tint (diff lines only)."
    },
    "status-person-line": {
      "light": "#6C1A5A",
      "dark": "#DA8BD0",
      "use": "Its line: mixed 45% with the rule for a card's quiet full border."
    },
    "status-ok": {
      "light": "#1E6B4F",
      "dark": "#6FD0A5",
      "use": "Status: done and good (succeeded, approved, gate passed)."
    },
    "status-ok-bg": {
      "light": "#E3F2EA",
      "dark": "#12302A",
      "use": "Its tint (added diff lines)."
    },
    "status-ok-line": { "light": "#2E8B67", "dark": "#3E9C78", "use": "Its line." },
    "status-bad": {
      "light": "#B42318",
      "dark": "#FF8A7E",
      "use": "Status: failed or stopped (failed, rejected, guardrail halted)."
    },
    "status-bad-bg": {
      "light": "#FCE6E3",
      "dark": "#3A1715",
      "use": "Its tint (removed diff lines)."
    },
    "status-bad-line": { "light": "#D0412F", "dark": "#E0574A", "use": "Its line." },
    "status-warn": {
      "light": "#835400",
      "dark": "#F2C46B",
      "use": "Status: needs attention (licence expiring, near a budget)."
    },
    "status-warn-bg": { "light": "#FBF0D9", "dark": "#33270F", "use": "Its tint." },
    "status-warn-line": { "light": "#C08A1E", "dark": "#C9962F", "use": "Its line." },
    "status-info": {
      "light": "#3B5B8C",
      "dark": "#9DB2D6",
      "use": "Status: in progress, or a note (running)."
    },
    "status-info-bg": { "light": "#E6ECF5", "dark": "#1A2740", "use": "Its tint." },
    "status-info-line": { "light": "#4D6080", "dark": "#6F86AE", "use": "Its line." },
    "status-muted": {
      "light": "#535D6E",
      "dark": "#A3ACBC",
      "use": "Status: inactive (queued, cancelled, draft)."
    },
    "status-muted-bg": { "light": "#ECEEF2", "dark": "#1E2633", "use": "Its tint." },
    "status-muted-line": { "light": "#A3ACBC", "dark": "#4A5568", "use": "Its line. Decorative." },
    "series-1": {
      "light": "#002A66",
      "dark": "#B7E9FF",
      "use": "Chart series, darkest ink: the biggest item."
    },
    "series-2": { "light": "#184381", "dark": "#9DCFFF", "use": "Chart series 2." },
    "series-3": { "light": "#2E5A9A", "dark": "#84B5EC", "use": "Chart series 3." },
    "series-4": { "light": "#4572B4", "dark": "#6C9CD1", "use": "Chart series 4." },
    "series-5": { "light": "#5C8ACE", "dark": "#5583B7", "use": "Chart series 5." },
    "series-muted": {
      "light": "#8B7E6D",
      "dark": "#918473",
      "use": "Warm stone: everything else, and the previous period (dashed)."
    }
  },
  "values": {
    "font": {
      "value": "\"IBM Plex Sans\", Arial, sans-serif",
      "use": "Everything you read. Self-hosted."
    },
    "font-mono": {
      "value": "\"IBM Plex Mono\", ui-monospace, Menlo, monospace",
      "use": "Code, commands and ids."
    },
    "narrow": {
      "value": "85%",
      "use": "font-stretch for headings and the wordmark (IBM Plex Sans at its narrowest)."
    },
    "radius": { "value": "0", "use": "Square: cards, buttons, dialogs, code." },
    "radius-field": { "value": "3px", "use": "Form fields only: text boxes, selects, search." },
    "row": { "value": "38px", "use": "A list or table row, the comfortable default." },
    "row-compact": { "value": "30px", "use": "A row in a compact view, where a list offers one." }
  },
  "contrast": {
    "$comment": "Each pair is checked in both themes: [foreground, background, minimum]. 4.5 is WCAG AA for text; 3 is WCAG 1.4.11 for graphics and component edges.",
    "pairs": [
      ["text", "page", 4.5],
      ["text", "card", 4.5],
      ["text", "field", 4.5],
      ["text-2", "page", 4.5],
      ["text-2", "card", 4.5],
      ["heading-2", "page", 4.5],
      ["heading-2", "card", 4.5],
      ["link", "page", 4.5],
      ["link", "card", 4.5],
      ["link-hover", "page", 4.5],
      ["link-hover", "card", 4.5],
      ["line", "page", 3],
      ["line", "card", 3],
      ["line", "field", 3],
      ["action", "page", 4.5],
      ["action", "card", 4.5],
      ["on-action", "action", 4.5],
      ["on-action", "action-hover", 4.5],
      ["kindgi-text", "kindgi", 4.5],
      ["kindgi-text-2", "kindgi", 4.5],
      ["accent", "kindgi", 4.5],
      ["kindgi-text", "kindgi-band", 4.5],
      ["kindgi-text-2", "kindgi-band", 4.5],
      ["on-accent", "accent", 4.5],
      ["on-accent", "accent-hover", 4.5],
      ["code-text", "code-bg", 4.5],
      ["accent", "code-bg", 4.5],
      ["status-person", "page", 4.5],
      ["status-person", "card", 4.5],
      ["status-person", "status-person-bg", 4.5],
      ["status-ok", "page", 4.5],
      ["status-ok", "card", 4.5],
      ["status-ok", "status-ok-bg", 4.5],
      ["status-bad", "page", 4.5],
      ["status-bad", "card", 4.5],
      ["status-bad", "status-bad-bg", 4.5],
      ["status-warn", "page", 4.5],
      ["status-warn", "card", 4.5],
      ["status-warn", "status-warn-bg", 4.5],
      ["status-info", "page", 4.5],
      ["status-info", "card", 4.5],
      ["status-info", "status-info-bg", 4.5],
      ["status-muted", "page", 4.5],
      ["status-muted", "card", 4.5],
      ["status-muted", "status-muted-bg", 4.5],
      ["text", "status-person-bg", 4.5],
      ["text", "status-ok-bg", 4.5],
      ["text", "status-bad-bg", 4.5],
      ["status-person-line", "card", 3],
      ["status-ok-line", "card", 3],
      ["status-bad-line", "card", 3],
      ["status-warn-line", "card", 3],
      ["status-info-line", "card", 3],
      ["series-1", "card", 3],
      ["series-2", "card", 3],
      ["series-3", "card", 3],
      ["series-4", "card", 3],
      ["series-5", "card", 3],
      ["series-muted", "card", 3]
    ]
  }
}
