---
/*
 * The next/previous links under each page: quiet text under a rule, not
 * Starlight's cards. The arrow says which way, so each is the arrow and the
 * page's title; "Previous" and "Next" stay for screen readers.
 */
import { Icon } from '@astrojs/starlight/components';

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';
---

<div class="kindgi-pagination print:hidden" dir={dir}>
  {
    prev && (
      <a href={prev.href} rel="prev">
        <Icon name={isRtl ? 'right-arrow' : 'left-arrow'} size="1rem" class="arrow" />
        <span class="sr-only">{Astro.locals.t('page.previousLink')}:</span>
        <span class="title">{prev.label}</span>
      </a>
    )
  }
  {
    next && (
      <a href={next.href} rel="next">
        <Icon name={isRtl ? 'left-arrow' : 'right-arrow'} size="1rem" class="arrow" />
        <span class="sr-only">{Astro.locals.t('page.nextLink')}:</span>
        <span class="title">{next.label}</span>
      </a>
    )
  }
</div>

<style>
  .kindgi-pagination {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 0.75rem 1rem;
    border-top: 1px solid var(--kg-rule);
    padding-top: 1rem;
  }
  a {
    display: flex;
    align-items: start;
    gap: 0.375rem;
    color: var(--kg-text);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  [rel='next'] {
    flex-direction: row-reverse;
    text-align: end;
  }
  /* The title underlines in plum on hover, as a link in the text does. */
  .title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }
  a:hover .title {
    text-decoration-color: var(--kg-action);
  }
  /* The arrow on the title's first line, should it wrap. */
  a :global(.arrow) {
    flex-shrink: 0;
    margin-block-start: calc((1lh - 1em) / 2);
    color: var(--kg-text-2);
  }
</style>
