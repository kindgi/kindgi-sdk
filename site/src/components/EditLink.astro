---
/*
 * "Edit page", "Report a problem" and the coding-agent pointer, under every
 * page.
 *
 * Edit goes to the page's source on main (Starlight's `editLink`): a
 * hand-written page's file under `site/`, or the `editUrl` a generated page
 * names (the contributing pages name their repository file). Generated
 * reference pages have no source to edit, so they get only the report link.
 *
 * The pointer to "Your coding agent" is on every page but that one: asking
 * a coding agent is the quickest way to build with Kindgi.
 */
import { Icon } from '@astrojs/starlight/components';

const REPOSITORY = 'https://github.com/kindgi/kindgi-sdk';
const GENERATED = 'src/content/docs/reference/';

const route = Astro.locals.starlightRoute;
const named = route.entry.data.editUrl;
const generated = route.entry.filePath?.startsWith(GENERATED) ?? true;
const editUrl =
  typeof named === 'string' ? named : named === false || generated ? undefined : route.editUrl?.href;

const page = new URL(Astro.url.pathname, 'https://docs.kindgi.com').href;
const issue = new URL(`${REPOSITORY}/issues/new`);
issue.searchParams.set('title', `Docs: ${route.entry.data.title}`);
issue.searchParams.set('body', `Page: ${page}\n\nWhat's wrong or missing:\n`);

const codingAgents = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}start/coding-agents/`;
const onCodingAgents = Astro.url.pathname.endsWith('/start/coding-agents/');
---

<div class="kindgi-page-links sl-flex print:hidden">
  {
    editUrl && (
      <a href={editUrl} class="sl-flex">
        <Icon name="pencil" size="1.2em" />
        {Astro.locals.t('page.editLink')}
      </a>
    )
  }
  <a href={issue.href} class="sl-flex">
    <Icon name="comment-alt" size="1.2em" />
    Report a problem with this page
  </a>
  {
    !onCodingAgents && (
      <a href={codingAgents} class="sl-flex">
        <Icon name="rocket" size="1.2em" />
        How your coding agent knows Kindgi
      </a>
    )
  }
</div>

<style>
  .kindgi-page-links {
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
  }
  a {
    gap: 0.5rem;
    align-items: center;
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }
  a:hover {
    color: var(--sl-color-white);
  }
</style>
