{
  "name": "@kindgi/connections",
  "version": "0.1.10",
  "description": "Kindgi™ connections: the app entries a Kindgi server reads to connect people's and a company's accounts at other apps (how to sign in, each permission in plain words, whose account it is, how access is withdrawn), defineApp to check one, the Google and GitHub entries, and tools that act with their connections (sending mail as a person; listing and labelling a repository's issues).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindgi/kindgi-sdk.git",
    "directory": "packages/connections"
  },
  "homepage": "https://github.com/kindgi/kindgi-sdk/tree/main/packages/connections#readme",
  "bugs": {
    "url": "https://github.com/kindgi/kindgi-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./google": {
      "types": "./dist/google.d.ts",
      "import": "./dist/google.js",
      "default": "./dist/google.js"
    },
    "./github": {
      "types": "./dist/github.d.ts",
      "import": "./dist/github.js",
      "default": "./dist/github.js"
    },
    "./google/tools": {
      "types": "./dist/google-tools.d.ts",
      "import": "./dist/google-tools.js",
      "default": "./dist/google-tools.js"
    },
    "./github/tools": {
      "types": "./dist/github-tools.d.ts",
      "import": "./dist/github-tools.js",
      "default": "./dist/github-tools.js"
    },
    "./app-fetch": {
      "types": "./dist/app-fetch.d.ts",
      "import": "./dist/app-fetch.js",
      "default": "./dist/app-fetch.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@kindgi/tools": "workspace:*",
    "@kindgi/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
