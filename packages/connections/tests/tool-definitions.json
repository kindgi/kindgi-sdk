  "outlookSend as company": {
    "version": "1.0.0",
    "definition": {
      "id": "acme.outlooksend-as-company",
      "description": "Send a plain-text email from the company's Outlook mailbox (the one a tenant admin connected) to the addresses in `to` and `cc`. Microsoft adds the From line: the sender is always that mailbox. Microsoft gives no id for the message; it's kept in the mailbox's Sent Items. In a run no person started, each send waits for a yes.",
      "version": "1.0.0",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "subject", "body"],
        "properties": {
          "to": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "format": "email",
              "maxLength": 254,
              "pattern": "^[^\\r\\n,;<>\"]+$"
            }
          },
          "cc": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "format": "email",
              "maxLength": 254,
              "pattern": "^[^\\r\\n,;<>\"]+$"
            }
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 900,
            "pattern": "^[^\\r\\n]*$"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500000
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": {
          "accepted": {
            "const": true
          }
        }
      },
      "effects": [
        {
          "kind": "external-side-effect",
          "resource": "external:outlook",
          "notes": "Sends mail as the company's mailbox."
        },
        {
          "kind": "sensitive-data-egress",
          "resource": "external:outlook"
        }
      ],
      "mutating": true,
      "needsApprovalWhenUnattended": true,
      "network": {
        "kind": "allowlist",
        "hosts": ["graph.microsoft.com"]
      },
      "needsSpec": {
        "connections": {
          "mail": {
            "app": "microsoft",
            "permissions": ["mail.send"],
            "as": "company"
          }
        }
      }
    }
  },
