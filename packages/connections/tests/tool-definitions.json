{
  "gmailSend": {
    "version": "1.0.0",
    "definition": {
      "id": "acme.gmailsend",
      "description": "Send a plain-text email from the person's own Gmail account (the one they connected) to the addresses in `to` and `cc`. Gmail adds the From line: the sender is always that person. Returns the sent message's id. In a run no person started, each send waits for that person's yes.",
      "version": "1.0.0",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "subject", "body"],
        "properties": {
          "to": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "format": "email",
              "maxLength": 254,
              "pattern": "^[^\\r\\n,;<>\"]+$"
            }
          },
          "cc": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "format": "email",
              "maxLength": 254,
              "pattern": "^[^\\r\\n,;<>\"]+$"
            }
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 900,
            "pattern": "^[^\\r\\n]*$"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500000
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messageId"],
        "properties": {
          "messageId": {
            "type": "string"
          }
        }
      },
      "effects": [
        {
          "kind": "external-side-effect",
          "resource": "external:gmail",
          "notes": "Sends mail as the person."
        },
        {
          "kind": "sensitive-data-egress",
          "resource": "external:gmail"
        }
      ],
      "mutating": true,
      "needsApprovalWhenUnattended": true,
      "network": {
        "kind": "allowlist",
        "hosts": ["gmail.googleapis.com"]
      },
      "needsSpec": {
        "connections": {
          "mail": {
            "app": "google",
            "permissions": ["gmail.send"],
            "as": "person"
          }
        }
      }
    }
  },
  "githubIssuesList": {
    "version": "1.0.0",
    "definition": {
      "id": "acme.githubissueslist",
      "description": "List a repository's issues, newest first, with the start of each body: open ones unless `state` says otherwise, only those with every label in `labels`, only those updated since `since`. Pull requests aren't listed. Reads only.",
      "version": "1.0.0",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "repo"],
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$",
            "description": "The account the repository is on, an organization or a user: \"acme\"."
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$",
            "not": {
              "enum": [".", ".."]
            },
            "description": "The repository's name: \"widgets\"."
          },
          "state": {
            "type": "string",
            "enum": ["open", "closed", "all"]
          },
          "labels": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "pattern": "^[^,]+$"
            }
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issues"],
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["number", "title", "body", "labels", "createdAt", "url"],
              "properties": {
                "number": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "author": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "effects": [
        {
          "kind": "reads",
          "resource": "external:github"
        },
        {
          "kind": "network",
          "resource": "external:github"
        }
      ],
      "mutating": false,
      "network": {
        "kind": "allowlist",
        "hosts": ["api.github.com"]
      },
      "needsSpec": {
        "connections": {
          "github": {
            "app": "github",
            "permissions": ["issues.read"],
            "as": "company"
          }
        }
      }
    }
  },
  "githubLabelsList": {
    "version": "1.0.0",
    "definition": {
      "id": "acme.githublabelslist",
      "description": "List the labels a repository has, with what each is for. Adding labels to an issue takes only these. Reads only.",
