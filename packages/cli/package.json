{
  "name": "@kindgi/cli",
  "version": "0.1.4-rc.1",
  "description": "Command-line interface for Kindgi™ — the sovereign AI OS. Create a pack, run it on your machine (`kindgi dev`), build, sign and deploy it, and work with a running Kindgi API from the terminal.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindgi/kindgi-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/kindgi/kindgi-sdk/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/kindgi/kindgi-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kindgi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@kindgi/client": "workspace:*",
    "@kindgi/dotenv-file": "workspace:*",
    "@kindgi/crypto": "workspace:*",
    "@kindgi/env-schema": "workspace:*",
    "@kindgi/flow": "workspace:*",
    "@kindgi/handler-runtime": "workspace:*",
    "@kindgi/secrets-dotenv": "workspace:*",
    "@kindgi/platform": "workspace:*",
    "@kindgi/sdk": "workspace:*",
    "@kindgi/types": "workspace:*",
    "esbuild": "^0.24.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.0",
    "tar": "^7.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/semver": "^7.8.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
