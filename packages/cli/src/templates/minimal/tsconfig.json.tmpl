{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "tools/**/*.ts",
    "guardrails/**/*.ts",
    "agents/**/*.ts",
    "flows/**/*.ts",
    "kindgi.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".kindgi"]
}
