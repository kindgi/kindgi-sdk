// The WooCommerce REST API (`/wp-json/wc/v3`), as this pack's tools call it.
//
// The tools sign in as a dedicated, low-privilege WordPress user (a Shop
// Manager made for the agent, never your own account) with an Application
// Password, which WordPress core has had since 5.6. It goes as HTTP Basic.
// The store's address and the user's name come from the env; the password
// is a secret, resolved by Kindgi on every call and handed to the tool in
// `ctx.secrets`: it's never in this code, the config or the chat.

/** What every store tool declares it needs (`needsSpec`). */
export const WOO_NEEDS = {
  env: {
    /** The store's address, e.g. `https://shop.example.com` (or `http://localhost:8080` locally). */
    WOO_STORE_URL: { type: 'string', pattern: '^https?://' },
    /** The WordPress user the agent signs in as. */
    WOO_USER: { type: 'string', minLength: 1 },
  },
  secrets: {
    /** That user's Application Password (Users → Profile → Application Passwords). */
    WOO_APP_PASSWORD: { type: 'string', minLength: 1 },
  },
} as const;

/** What the refund tools declare: the store's, plus whether the gateway moves the money. */
export const REFUND_NEEDS = {
  env: {
    ...WOO_NEEDS.env,
    /** `true`: the payment gateway refunds the money (`api_refund`). Default `false`. */
    WOO_REFUND_THROUGH_GATEWAY: { type: 'string', enum: ['true', 'false'], default: 'false' },
  },
  secrets: WOO_NEEDS.secrets,
} as const;

/** The part of a tool call's context the store client reads. */
export interface WooContext {
  readonly env?: Readonly<Record<string, string | undefined>>;
  readonly secrets?: Readonly<Record<string, string | undefined>>;
}

/** A call to the store that WooCommerce refused: its status and its own words. */
export class WooError extends Error {
  override readonly name = 'WooError';
  constructor(
    readonly status: number,
    message: string,
  ) {
    super(message);
  }
}

/** Call the WooCommerce REST API: `path` is under `/wp-json/wc/v3/`. */
export async function woo<T>(
  ctx: WooContext,
  method: 'GET' | 'POST' | 'PUT',
  path: string,
  body?: unknown,
): Promise<T> {
  const base = ctx.env?.WOO_STORE_URL;
  const user = ctx.env?.WOO_USER;
  const password = ctx.secrets?.WOO_APP_PASSWORD;
  if (base === undefined || user === undefined || password === undefined) {
    throw new Error('WOO_STORE_URL, WOO_USER and WOO_APP_PASSWORD must be set: see README.md');
  }
  // Relative to the store's address, so a store under a path (`/shop/`) works too.
  const url = new URL(`wp-json/wc/v3/${path.replace(/^\/+/, '')}`, base.endsWith('/') ? base : `${base}/`);
  const response = await fetch(url, {
    method,
    headers: {
      authorization: `Basic ${Buffer.from(`${user}:${password}`).toString('base64')}`,
      accept: 'application/json',
      ...(body !== undefined && { 'content-type': 'application/json' }),
    },
    ...(body !== undefined && { body: JSON.stringify(body) }),
  });
  const text = await response.text();
  if (!response.ok) {
    let reason = text.slice(0, 300);
    try {
      const parsed = JSON.parse(text) as { message?: unknown };
      if (typeof parsed.message === 'string') reason = parsed.message;
    } catch {
      // Not JSON: keep the start of the body.
    }
    throw new WooError(response.status, `WooCommerce answered ${response.status} to ${method} ${url.pathname}: ${reason}`);
  }
  return (text === '' ? undefined : JSON.parse(text)) as T;
}

/** The order fields the tools read. */
export interface WooOrder {
  readonly id: number;
  readonly number: string;
  readonly status: string;
  readonly currency: string;
  readonly total: string;
  readonly date_created: string;
  readonly billing?: { readonly first_name?: string; readonly last_name?: string };
  readonly refunds?: readonly { readonly id: number; readonly total: string }[];
}

/** What an order has been refunded already (WooCommerce lists refunds as negative totals). */
export function refundedSoFar(order: WooOrder): number {
  return (order.refunds ?? []).reduce((sum, r) => sum + Math.abs(Number(r.total) || 0), 0);
}

/**
 * Refund `amount` on an order, through WooCommerce's refunds API. With
 * `WOO_REFUND_THROUGH_GATEWAY=true` the payment gateway moves the money
 * (`api_refund`); otherwise WooCommerce records the refund and the money
 * moves however your shop moves it (the default, and what a local store
 * does).
 */
export async function createRefund(
  ctx: WooContext,
  input: { readonly orderId: number; readonly amount: number; readonly reason: string },
): Promise<{ readonly refundId: number; readonly orderId: number; readonly amount: string; readonly currency: string }> {
  const order = await woo<WooOrder>(ctx, 'GET', `orders/${input.orderId}`);
  const refund = await woo<{ readonly id: number; readonly amount: string }>(
    ctx,
    'POST',
    `orders/${input.orderId}/refunds`,
    {
      amount: input.amount.toFixed(2),
      reason: input.reason,
      api_refund: ctx.env?.WOO_REFUND_THROUGH_GATEWAY === 'true',
    },
  );
  return { refundId: refund.id, orderId: input.orderId, amount: refund.amount, currency: order.currency };
}
