// {{PACK_ID}}.woo.refund — a refund of up to 100 (in the order's currency) on
// an order, with no one to approve it when a person asks for it. In a run a
// webhook or a schedule started, it waits for a person's yes.
//
// Kindgi's approval rules key on the tool, not on its arguments, so "refunds
// over 100 need a person" is two tools: this one, which the agent's policy
// lets run on its own, and `{{PACK_ID}}.woo.refund-large`, which always waits
// for a person. The limit is enforced here, not by the model:
//   - the input schema caps one refund at `maximum: 100`, and Kindgi checks
//     every call against it before the handler runs;
//   - the handler refuses a refund that would take what the order has been
//     refunded past 100, so splitting a large refund into small ones
//     doesn't get around the approval.
// Change `REFUND_LIMIT` to change the limit (the schema follows).
import { defineTool } from '@kindgi/sdk/define';
import type { ToolId } from '@kindgi/sdk/types';
import { z } from 'zod';

import { REFUND_NEEDS, type WooOrder, createRefund, refundedSoFar } from '../../lib/woo.js';

/** The most this tool refunds on one order, in the order's currency. */
export const REFUND_LIMIT = 100;

export const RefundInput = z.object({
  orderId: z.number().int().positive(),
  amount: z
    .number()
    .positive()
    .max(REFUND_LIMIT)
    .describe(`At most ${REFUND_LIMIT}; a larger refund goes through the refund-large tool.`),
  reason: z.string().min(3).max(500),
});

export const RefundOutput = z.object({
  refundId: z.number().int(),
  orderId: z.number().int(),
  amount: z.string(),
  currency: z.string(),
});

const defined = defineTool({
  id: '{{PACK_ID}}.woo.refund' as ToolId,
  description: `Refund up to ${REFUND_LIMIT} on an order, counting what it has been refunded already. Runs without approval when a person starts the turn; in a run a webhook or schedule started, it waits for a person. For more, use {{PACK_ID}}.woo.refund-large, which waits for a person.`,
  version: '{{PACK_VERSION}}',
  input: RefundInput,
  output: RefundOutput,
  effects: [
    { kind: 'writes', resource: 'external:woocommerce' },
    { kind: 'external-side-effect', notes: 'Refunds money to the customer.' },
  ],
  mutating: true,
  // In a run no person started (a webhook, a schedule or a service account's
  // key started it), every call waits for a person's yes, whatever the
  // agent's approval policy says.
  needsApprovalWhenUnattended: true,
  // How an approval of a call reads, the call's own values filled in. A
  // reviewer sees these words once signed in; the mail names only the tool.
  approval: {
    title: 'Refund {amount} on order #{orderId}',
    summary: '{reason}',
    about: { kind: 'woocommerce.order', id: '{orderId}' },
  },
  needsSpec: REFUND_NEEDS,
  // The limit is checked after `createRefund` has looked for this call's own
  // refund: a call run again after its refund went out returns that refund,
  // instead of counting it against itself.
  handler: async (input, ctx) =>
    createRefund(ctx, input, (order: WooOrder) => {
      const already = refundedSoFar(order);
      if (already + input.amount > REFUND_LIMIT) {
        throw new Error(
          `Order ${order.number} has been refunded ${already.toFixed(2)} already; with ${input.amount.toFixed(2)} more it passes ${REFUND_LIMIT}. Use {{PACK_ID}}.woo.refund-large, which waits for a person.`,
        );
      }
    }),
});

if (defined.kind === 'err') {
  throw new Error(`{{PACK_ID}}.woo.refund failed to compile: ${defined.error.message}`);
}

export default defined.value;
