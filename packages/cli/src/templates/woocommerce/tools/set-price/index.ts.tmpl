// {{PACK_ID}}.woo.set-price — change a product's regular price. A store
// change, so the agent's approval policy has a person approve every call.
// The tool also declares it waits in a run no person started, so even an
// agent whose policy says `never_ask` can't run it there unasked.
import { defineTool } from '@kindgi/sdk/define';
import type { ToolId } from '@kindgi/sdk/types';
import { z } from 'zod';

import { WOO_NEEDS, woo } from '../../lib/woo.js';

const defined = defineTool({
  id: '{{PACK_ID}}.woo.set-price' as ToolId,
  description: "Change a product's regular price. Waits for a person to approve it.",
  version: '{{PACK_VERSION}}',
  input: z.object({
    productId: z.number().int().positive(),
    regularPrice: z.number().positive(),
  }),
  output: z.object({ productId: z.number().int(), name: z.string(), regularPrice: z.string() }),
  effects: [{ kind: 'writes', resource: 'external:woocommerce' }],
  mutating: true,
  // In a run no person started (a webhook, a schedule or a service account's
  // key started it), every call waits for a person's yes, whatever the
  // agent's approval policy says.
  needsApprovalWhenUnattended: true,
  // How an approval of a call reads, the call's own values filled in. A
  // reviewer sees these words once signed in; the mail names only the tool.
  approval: {
    title: 'Set the price of product #{productId} to {regularPrice}',
    about: { kind: 'woocommerce.product', id: '{productId}' },
  },
  needsSpec: WOO_NEEDS,
  handler: async ({ productId, regularPrice }, ctx) => {
    const product = await woo<{ readonly id: number; readonly name: string; readonly regular_price: string }>(
      ctx,
      'PUT',
      `products/${productId}`,
      { regular_price: regularPrice.toFixed(2) },
    );
    return { productId: product.id, name: product.name, regularPrice: product.regular_price };
  },
});

if (defined.kind === 'err') {
  throw new Error(`{{PACK_ID}}.woo.set-price failed to compile: ${defined.error.message}`);
}

export default defined.value;
