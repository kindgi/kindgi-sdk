// {{PACK_ID}}.woo.publish-product — publish a draft product, so shoppers can
// see it. A store change, so the agent's approval policy has a person
// approve every call. The tool also declares it waits in a run no person
// started, so even an agent whose policy says `never_ask` can't run it
// there unasked.
import { defineTool } from '@kindgi/sdk/define';
import type { ToolId } from '@kindgi/sdk/types';
import { z } from 'zod';

import { WOO_NEEDS, woo } from '../../lib/woo.js';

const defined = defineTool({
  id: '{{PACK_ID}}.woo.publish-product' as ToolId,
  description: 'Publish a draft product in the store. Waits for a person to approve it.',
  version: '{{PACK_VERSION}}',
  input: z.object({ productId: z.number().int().positive() }),
  output: z.object({ productId: z.number().int(), name: z.string(), status: z.string() }),
  effects: [{ kind: 'writes', resource: 'external:woocommerce' }],
  mutating: true,
  // In a run no person started (a webhook, a schedule or a service account's
  // key started it), every call waits for a person's yes, whatever the
  // agent's approval policy says.
  needsApprovalWhenUnattended: true,
  // How an approval of a call reads, the call's own values filled in. A
  // reviewer sees these words once signed in; the mail names only the tool.
  approval: {
    title: 'Publish product #{productId}',
    about: { kind: 'woocommerce.product', id: '{productId}' },
  },
  needsSpec: WOO_NEEDS,
  handler: async ({ productId }, ctx) => {
    const product = await woo<{ readonly id: number; readonly name: string; readonly status: string }>(
      ctx,
      'PUT',
      `products/${productId}`,
      { status: 'publish' },
    );
    return { productId: product.id, name: product.name, status: product.status };
  },
});

if (defined.kind === 'err') {
  throw new Error(`{{PACK_ID}}.woo.publish-product failed to compile: ${defined.error.message}`);
}

export default defined.value;
