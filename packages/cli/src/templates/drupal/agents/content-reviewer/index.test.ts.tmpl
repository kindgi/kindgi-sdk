// {{PACK_ID}}.content-reviewer — what its instructions may name. The event
// is outside input, and an editor writes its title, so the instructions
// interpolate only fields the check types and works out itself; the title
// reaches the reviewer in its message, as data.

import { describe, expect, test } from 'vitest';

import reviewer from './index.js';

/** The checked event's fields that no editor writes (`check-content-event`). */
const TYPED = ['change', 'nodeId', 'revisionId', 'moderationState', 'flags', 'houseStyle'];

describe('{{PACK_ID}}.content-reviewer', () => {
  test("its instructions interpolate the event's typed fields only", () => {
    const instructions = reviewer.instructions;
    if (typeof instructions !== 'string') throw new Error('expected inline instructions');
    const named = [...instructions.matchAll(/\{\{-?\s*([\w.[\]"']+)/g)].map((m) => m[1]);
    expect(named.length).toBeGreaterThan(0);
    for (const name of named) {
      expect(TYPED.map((field) => `input.event.${field}`), name).toContain(name);
    }
    expect(instructions).not.toMatch(/\{%/);
  });
});
