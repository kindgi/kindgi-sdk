// {{PACK_ID}}.content-agent — what it's told about the tools that wait for
// a person. The model never sees the approval: a call that waited comes back
// with its result once a person decided. So the instructions say what a
// result means, for exactly the tools the approval policy holds back.

import { describe, expect, test } from 'vitest';

import contentAgent from './index.js';

/** Whether `text` names `id` whole: `drupal.tool_api__get_fields` isn't named by a longer id. */
function names(text: string, id: string): boolean {
  const escaped = id.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return new RegExp(`(?<![\\w.-])${escaped}(?![\\w-])`).test(text);
}

describe('{{PACK_ID}}.content-agent', () => {
  test('its instructions name every tool that waits for a person, and say which results mean it was done', () => {
    const { instructions } = contentAgent;
    // Written in the agent, so the test reads them. Moved to a prompt, check that prompt the same way.
    if (typeof instructions !== 'string') throw new Error('The instructions are a prompt reference now: check the prompt.');
    const policy = contentAgent.conversationPolicy?.hitl?.tools;
    expect(policy?.default).toBe('always_ask');
    const free = new Set(
      Object.entries(policy?.overrides ?? {})
        .filter(([, mode]) => mode === 'never_ask')
        .map(([id]) => id),
    );
    const waiting = contentAgent.tools.map((t) => t.id).filter((id) => !free.has(id));
    expect(waiting.length).toBeGreaterThan(0);
    const line = instructions.split('\n').find((l) => l.includes('run only after a person approves them'));
    expect(line).toBeDefined();
    for (const id of waiting) expect(names(line ?? '', id), id).toBe(true);
    // A rejection and a failure come back as results too: neither may read as done.
    expect(line).toContain('"status": "rejected"');
    expect(line).toContain('"status": "failed"');
    expect(line).toMatch(/"status": "failed"[^.]*didn't go through[^.]*never that it was done/);
    expect(line).toContain('Any other result means a person approved it and it was done');
    // What it read before the wait may be stale by the time it returns.
    expect(line).toMatch(/look it up again before you say what state it's in/);
  });

  test("its instructions don't tell it to say a call waits: it never answers while one does", () => {
    const { instructions } = contentAgent;
    if (typeof instructions !== 'string') throw new Error('The instructions are a prompt reference now: check the prompt.');
    expect(instructions).not.toMatch(/waits? for a person/i);
  });
});
