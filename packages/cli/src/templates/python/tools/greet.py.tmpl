"""{{PACK_ID}}.greet — greets a named recipient."""

from pydantic import BaseModel, Field

from kindgi import tool


class GreetInput(BaseModel):
    name: str = Field(min_length=1, max_length=100)
    greeting: str = Field("Hello", min_length=1, max_length=50)


class Greeting(BaseModel):
    message: str


@tool(id="{{PACK_ID}}.greet")
def greet(input: GreetInput) -> Greeting:
    """Formats a greeting for the named recipient."""
    return Greeting(message=f"{input.greeting}, {input.name}!")
