[project]
name = "{{PACK_NAME}}"
version = "{{PACK_VERSION}}"
description = "A Kindgi pack — scaffolded by `kindgi init --template=python`."
requires-python = ">=3.11"
dependencies = [{{KINDGI_REQUIREMENT}}]

[dependency-groups]
dev = [{{DEV_DEPENDENCIES}}]

# The uv versions this pack works with: `kindgi build` installs it with the
# uv in Kindgi's image, which reads the uv.lock they write.
[tool.uv]
required-version = "{{UV_REQUIRED_VERSION}}"
{{KINDGI_PYTHON_SOURCE}}
# The pack: what `kindgi dev`, `kindgi build` and `python -m kindgi.pack` read.
[tool.kindgi.pack]
id = "{{PACK_ID}}"
version = "{{PACK_VERSION}}"
description = "A sample Kindgi pack in Python — two tools, one guardrail, one agent, one flow."

# Optional — the defaults are shown.
# [tool.kindgi.discovery]
# tools = "tools/**/*.py"
# guardrails = "guardrails/**/*.py"
# agents = "agents/**/*.py"
# flows = "flows/**/*.py"

# [tool.kindgi.dev]
# python = ["uv", "run", "python"]   # default: .venv/bin/python, else python3
# envFiles = [".env", ".env.local"]

# One block per place you deploy to; `kindgi build --env=<name>` reads it.
# Your API key goes only to the address you signed in to
# (`kindgi auth login --url <url>`), so an `endpoint` must be that address.
# Builds are signed with a key of yours: make it with `kindgi key create <id>`,
# and let the runtime trust it with `kindgi key trust <id>` (once).
# [tool.kindgi.environments.production]
# endpoint = "https://kindgi.your-company.example"   # the address you signed in to
# build = "https://build.your-company.example"       # your Kindgi build server
# tenantId = "<your tenant id>"
# signingKey = "~/.kindgi/keys/<id>.pem"

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
