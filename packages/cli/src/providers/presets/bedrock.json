    "models": [
      {
        "name": "us.anthropic.claude-sonnet-5-5",
        "contextWindow": 1000000,
        "maxOutputTokens": 16000,
        "thinking": { "mode": "adaptive", "lowest": "between_tools" },
        "sampling": false,
        "features": ["tool-use", "parallel-tool-use", "structured-output", "long-context"],
        "cost": {
          "promptUsdPer1kTokens": 0.0022,
          "completionUsdPer1kTokens": 0.011,
          "cachedPromptMultiplier": 0.05,
          "promptCacheCreationMultiplier": 1.25
