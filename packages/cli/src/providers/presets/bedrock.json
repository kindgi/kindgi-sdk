{
  "name": "bedrock",
  "description": "Claude, Nova and GPT on Amazon Bedrock, as the runtime's AWS identity (KINDGI_AWS_IDENTITY; --region=<a US region>). The models are US cross-region inference profiles.",
  "adapterId": "@kindgi/adapter-model-bedrock",
  "adapterConfig": [
    {
      "key": "region",
      "description": "The US region Bedrock runs in, e.g. us-east-2: the preset's models are us. cross-region inference profiles.",
      "in": "metadata"
    }
  ],
  "pricesCheckedAt": "2026-10-09",
