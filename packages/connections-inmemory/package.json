{
  "name": "@kindgi/connections-inmemory",
  "version": "0.8.1",
  "description": "An in-memory ConnectionBinding and ConnectionResolver with a fake app, for development and tests only; refuses to start in production.",
  "license": "Apache-2.0",
  "homepage": "https://docs.kindgi.com",
  "bugs": {
    "email": "contact@kindgi.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kindgi/agents": "workspace:*",
    "@kindgi/api": "workspace:*",
    "@kindgi/authz": "workspace:*",
    "@kindgi/connections": "workspace:*",
    "@kindgi/tools": "workspace:*",
    "@kindgi/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
