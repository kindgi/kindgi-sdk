{
  "name": "@kindgi/agents",
  "version": "0.1.3",
  "description": "Agent primitive for Kindgi. Composes capabilities (model routing), tools (execution), memory (facts + retrieval), guardrails (declarative guardrails), and provenance into a single declarative unit. Agents are data-as-code — a defineAgent() call produces a durable definition that runs on the kernel, with first-class multi-turn conversations, streaming output, and a provenance record per turn.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindgi/kindgi-sdk.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/kindgi/kindgi-sdk/tree/main/packages/agents#readme",
  "bugs": {
    "url": "https://github.com/kindgi/kindgi-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "migrations", "README.md", "SPEC.md", "type-manifest.json"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@kindgi/authz": "workspace:*",
    "@kindgi/capabilities": "workspace:*",
    "@kindgi/compliance": "workspace:*",
    "@kindgi/embedding": "workspace:*",
    "@kindgi/flow": "workspace:*",
    "@kindgi/handler": "workspace:*",
    "@kindgi/guardrails": "workspace:*",
    "@kindgi/memory": "workspace:*",
    "@kindgi/policy-contract": "workspace:*",
    "@kindgi/provenance": "workspace:*",
    "@kindgi/runtime": "workspace:*",
    "@kindgi/schema": "workspace:*",
    "@kindgi/tools": "workspace:*",
    "@kindgi/types": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "liquidjs": "^10.29.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
