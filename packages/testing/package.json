{
  "name": "@kindgi/testing",
  "version": "0.1.1",
  "description": "Test helpers for Kindgi apps and packages. `createStubAppBindings()` supplies every binding `createApp` requires as a typed stub that throws a descriptive `StubBindingError` if called — mount the API for contract / route-shape tests without a database or the Kindgi runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindgi/kindgi-sdk.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/kindgi/kindgi-sdk/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/kindgi/kindgi-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "type-manifest.json"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kindgi/agents": "workspace:*",
    "@kindgi/api": "workspace:*",
    "@kindgi/memory": "workspace:*",
    "@kindgi/platform": "workspace:*",
    "@kindgi/runtime": "workspace:*"
  },
  "devDependencies": {
    "@kindgi/types": "workspace:*",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
