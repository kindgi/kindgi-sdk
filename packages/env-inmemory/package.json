{
  "name": "@kindgi/env-inmemory",
  "version": "0.1.5-rc.0",
  "description": "Reference in-memory `EnvBinding` adapter — dev + tests only; refuses to boot in production.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindgi/kindgi-sdk.git",
    "directory": "packages/env-inmemory"
  },
