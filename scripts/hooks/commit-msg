#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# Commit-msg: the message leaves out what a pull request's text leaves out
# (scripts/check-pr-text.mjs --message): a pull request's commits are
# public. Caught here, before the commit exists, rewording is easy; once
# pushed, it means rewriting the branch.
#
# See CONTRIBUTING.md ("Public text").

set -eu

# Without Node (a GUI client's PATH, say), the message isn't checked here, and says so; the
# PR text check still reads every commit.
if ! command -v node > /dev/null 2>&1; then
  echo "commit-msg: node isn't on PATH, so this message isn't checked here (the PR text check still reads it)." >&2
  exit 0
fi

exec node "$(dirname "$0")/../check-pr-text.mjs" --message "$1"
