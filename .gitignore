# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Build output
dist/
.astro/
build/
# packages/cli/src/build/ is source, not output: the pipeline stages of
# `kindgi build` (as src/dev/ is for `kindgi dev`). Biome reads only this
# file, not a package's own .gitignore, so the CLI's source folder is
# re-included here.
!packages/cli/src/build/
out/
*.tsbuildinfo
.turbo/
# Maven (sdks/java)
sdks/java/**/target/
# sbt (sdks/scala, and the Scala conformance fixture)
sdks/scala/**/target/
sdks/scala/.bsp/
packages/pack-conformance/fixtures/scala-pack/**/target/
packages/pack-conformance/fixtures/scala-pack/.bsp/

# Test + coverage
coverage/
.vitest/
*.log

# Environment
.env
.env.local
.env.*.local
!.env.example

# Editor
.vscode/*
!.vscode/settings.example.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
.DS_Store
._*

# Docker
.docker-data/

# Local data volumes (docker-compose)
data/postgres/
data/minio/

# Temporary
tmp/
temp/
*.tmp

# Local chat transcripts from coding assistants
chats/

# Local pack test tarballs (from `pnpm pack`)
*.tgz

# Local scratch notes (never committed)
.scratch/

# Python (sdks/python)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# The docs site's generated reference pages (site/scripts/generate-reference.mjs)
site/src/content/docs/reference/cli/
site/src/content/docs/reference/env-vars.md
site/src/content/docs/reference/schemas/
site/src/content/docs/reference/packages/
site/src/content/docs/reference/typescript/
site/src/content/docs/reference/python/
site/src/content/docs/contributing/*
!site/src/content/docs/contributing/index.md
site/generated/
site/dist-versions/
site/dist-preview/
