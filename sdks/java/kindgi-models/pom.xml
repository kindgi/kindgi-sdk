<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.kindgi</groupId>
    <artifactId>kindgi-java-parent</artifactId>
    <version>0.1.6</version>
  </parent>

  <artifactId>kindgi-models</artifactId>
  <name>Kindgi Java models</name>
  <description>The Kindgi™ API's models for Java: records, unions and enums, with builders and the API's checks. kindgi-client brings them; an app's own Jackson reads and writes them. In preview: tested and supported, but the API may still change in 0.1.6 without the usual deprecation period.</description>

  <properties>
    <kindgi.openapi>${project.basedir}/../../../packages/api/openapi.json</kindgi.openapi>
  </properties>

  <dependencies>
    <!--
      Optional, and pinned to 2.15 (Spring Boot 3.2's): the models use only annotation types and
      attributes that exist there, and compiling against 2.15 proves it. An app that has Jackson
      (2 or 3) reads the models through these annotations; one that doesn't, doesn't need them.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>2.15.4</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>1.0.1</version>
    </dependency>

    <!-- An app's own Jackson 2, as old as Boot 3.2's: it reads and writes the models. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.15.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.15.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/../../..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>com.kindgi</groupId>
        <artifactId>kindgi-codegen-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <openapi>${kindgi.openapi}</openapi>
              <target>models</target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>com.kindgi.models</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
