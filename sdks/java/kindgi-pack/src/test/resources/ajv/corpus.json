    {
      "name": "anyOf and allOf and not",
      "schema": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "a": {
                "type": "string"
              }
            },
            "required": ["a"]
          },
          {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "b": {
                    "type": "integer"
                  }
                },
                "required": ["b"]
              },
              {
                "type": "object",
                "properties": {
                  "c": {
                    "type": "integer"
                  }
                },
                "required": ["c"]
              }
            ]
          },
          {
            "not": {
              "type": "object",
              "properties": {
                "d": {
                  "const": true
                }
              },
              "required": ["d"]
            }
          }
        ]
      },
      "values": [
        {
          "a": "x",
          "b": 1
        },
        {
          "a": "x",
          "c": 1
        },
        {
          "a": 1
        },
        {
          "a": "x"
        },
        {
          "a": "x",
          "b": 1,
          "d": true
        }
      ]
    },
    {
      "name": "$ref and $defs",
      "schema": {
        "$defs": {
          "point": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
