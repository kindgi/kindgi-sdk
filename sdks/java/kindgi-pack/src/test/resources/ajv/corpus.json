            "maxLength": 2
          }
        }
      },
      "values": [
        {
          "code": "abc"
        },
        {
          "code": "Abc"
        },
        {
          "code": "abcdefghij"
        },
        {
          "emoji": "😀😀"
        },
        {
          "emoji": "😀😀😀"
        }
      ]
    },
