            "required": ["x", "y"],
            "additionalProperties": false
          }
        },
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/$defs/point"
          },
          "to": {
            "$ref": "#/$defs/point"
          }
        },
        "required": ["from"]
      },
      "values": [
        {
          "from": {
            "x": 1,
            "y": 2
          }
        },
        {
          "from": {
            "x": 1
          }
