{
  "$comment": "The Java validator's corpus: each schema, and values to run through it. scripts/ajv-oracle.mjs runs them through Ajv into oracle.json.",
  "cases": [
    {
      "name": "echo (a closed record)",
      "schema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["message"],
        "additionalProperties": false
      },
      "values": [
        {
          "message": "hi"
        },
        {},
        {
          "message": ""
        },
        {
          "message": "hi",
          "extra": 1
        },
        {
          "message": 7
        },
        "text",
        null,
        [],
        {
          "message": 7,
          "a": 1,
          "b": 2
        }
      ]
    },
    {
      "name": "numbers",
      "schema": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "x": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1,
            "multipleOf": 0.25
          }
        }
      },
      "values": [
        {
          "n": 1
        },
        {
          "n": -1
        },
        {
          "n": 11
        },
        {
          "n": 1.5
