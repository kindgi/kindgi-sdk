<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.kindgi</groupId>
    <artifactId>kindgi-java-parent</artifactId>
    <version>0.1.4</version>
  </parent>

  <artifactId>kindgi-client</artifactId>
  <name>Kindgi Java client</name>
  <description>Java client for the Kindgi™ API: agents, runs, approvals, evals and the rest, with typed models, typed errors, paging, streaming and retries.</description>

  <properties>
    <!-- The API document the client is generated from (packages/api in this repository). -->
    <kindgi.openapi>${project.basedir}/../../../packages/api/openapi.json</kindgi.openapi>
    <!-- Where the client's own Jackson lives in its jar (shaded: no conflict with an app's Jackson). -->
    <kindgi.shaded>com.kindgi.client.internal.shaded</kindgi.shaded>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.kindgi</groupId>
      <artifactId>kindgi-models</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Shaded into the jar (below), so they aren't dependencies of the published client. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>1.0.1</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>${project.basedir}/../../..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>com.kindgi</groupId>
        <artifactId>kindgi-codegen-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <openapi>${kindgi.openapi}</openapi>
              <target>client</target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          What an app compiles against besides the client's own jar (its dependencies as the published
          POM lists them: the shaded Jackson isn't one). The docs' sample check reads it.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>samples-classpath</id>
            <phase>package</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <excludeGroupIds>tools.jackson.core,com.fasterxml.jackson.core</excludeGroupIds>
              <outputFile>${project.build.directory}/samples-classpath.txt</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <artifactSet>
                <includes>
                  <include>tools.jackson.core:jackson-core</include>
                  <include>tools.jackson.core:jackson-databind</include>
                  <include>com.fasterxml.jackson.core:jackson-annotations</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>tools.jackson</pattern>
                  <shadedPattern>${kindgi.shaded}.jackson</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.fasterxml.jackson.annotation</pattern>
                  <shadedPattern>${kindgi.shaded}.jackson.annotation</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>tools.jackson.core:*</artifact>
                  <excludes>
                    <!-- Apache-2.0, as the client's own LICENSE; its NOTICE is merged below. -->
                    <exclude>META-INF/LICENSE</exclude>
                    <!-- The base classes target Java 17: the client's own Jackson needs no others. -->
                    <exclude>META-INF/versions/**</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>com.fasterxml.jackson.core:*</artifact>
                  <excludes>
                    <!-- Apache-2.0, as the client's own LICENSE; its NOTICE is merged below. -->
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/versions/**</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                  <addHeader>false</addHeader>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Automatic-Module-Name>com.kindgi.client</Automatic-Module-Name>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
